rules_version = '2';
service cloud.firestore {
  match /databases/{d}/documents {
    function ok() { return request.auth != null; }
    // Super Admin = le développeur (cette adresse doit aussi être DEV_EMAIL dans firebase.js)
    function sa() { return ok() && request.auth.token.email == 'gabbyumba344@gmail.com'; }
    function prof() { return get(/databases/$(d)/documents/users/$(request.auth.uid)).data; }
    function r(x) { return sa() || (ok() && exists(/databases/$(d)/documents/users/$(request.auth.uid)) && prof().role == x); }
    function staff() { return r('admin') || r('gerant') || r('serveur'); }
    function only(k) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(k); }

    // Comptes : seul le Super Admin crée/modifie ; chacun lit le sien ; l'admin lit la liste
    match /users/{u} { allow read: if ok() && (request.auth.uid == u || r('admin')); allow write: if sa(); }

    // Configuration : le Super Admin tout ; l'Administrateur uniquement le prix du jeton de billard
    match /config/{c} { allow read: if staff(); allow write: if sa() || (c == 'billiard' && r('admin')); }

    match /products/{p} {
      allow read: if staff();
      allow create, delete: if sa();
      allow update: if sa()
        || (r('admin') && only(['price']))                                                  // l'admin modifie les prix
        || (r('gerant') && only(['stock']) && request.resource.data.stock > resource.data.stock)   // le gérant ajoute du stock
        || ((r('serveur') || r('gerant')) && only(['stock']) && request.resource.data.stock < resource.data.stock); // une vente décrémente
    }

    match /rooms/{x} { allow read: if staff(); allow create, delete: if sa(); allow update: if sa() || (r('gerant') && only(['status'])); }

    // Ventes : créées par le serveur à son nom, jamais modifiées ni supprimées
    match /sales/{s} {
      allow read: if r('admin') || r('gerant') || (r('serveur') && resource.data.serverId == request.auth.uid);
      allow create: if staff() && request.resource.data.serverId == request.auth.uid && request.resource.data.total is number && request.resource.data.items.size() > 0;
      allow update, delete: if false;
    }

    // Billard : saisi par le gérant, lu par la direction
    match /tokens/{t} { allow read: if r('admin') || r('gerant'); allow write: if r('gerant'); }

    match /{document=**} { allow read, write: if false; }
  }
}
